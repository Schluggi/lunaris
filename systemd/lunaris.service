# systemd unit for lunaris
#
# Broker host/port and other flags: edit this unit, or prefer a drop-in:
#   sudo systemctl edit lunaris
# and set e.g.:
#   [Service]
#   ExecStart=
#   ExecStart=/usr/local/bin/lunaris --mqtt-host 192.168.1.10
#
# Optional environment (e.g. RUST_LOG): create /etc/default/lunaris
#   RUST_LOG=info

[Unit]
Description=lunaris - Custom Home Assistant first firmware for Eight Sleep Pod
Documentation=https://github.com/Schluggi/lunaris
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lunaris --mqtt-host 192.168.1.10 --mqtt-username user123 --mqtt-password password123
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
